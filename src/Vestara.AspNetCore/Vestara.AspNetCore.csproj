<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Vestara.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>Vestara</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>ASP.NET Core integration for Vestara request correlation, failure capture, and failure trails.</Description>
    <PackageTags>vestara;aspnetcore;logging;crash-reporting;observability;telemetry</PackageTags>
    <RootNamespace>Vestara.AspNetCore</RootNamespace>
    <AssemblyName>Vestara.AspNetCore</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vestara\Vestara.csproj" />
  </ItemGroup>

</Project>
